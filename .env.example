# Copy to .env.local and fill in. Never commit the real file.
# All four are read by api/chat.js; the last two have defaults and can be left out.

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=chat
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
